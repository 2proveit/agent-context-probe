# LLM Proxy Configuration Example
# This file demonstrates all available configuration options
# Copy this file to config.yaml and customize as needed

# Server configuration
server:
  # Interface to listen on. The default accepts connections only from this host.
  host: "127.0.0.1"

  # Port to listen on (default: 3001)
  port: 3001

  # Required when host is not loopback. Remote clients send this value in the
  # X-Agent-Context-Probe-Token header; browser users sign in at /auth.
  # Prefer ACP_ACCESS_TOKEN so the secret is not stored in this file.
  # access_token: "replace-with-at-least-16-characters"
  
  # Timeout configurations
  timeouts:
    # Maximum duration for reading the entire request, including the body
    read: 10m
    
    # Maximum duration before timing out writes of the response
    write: 10m
    
    # Maximum amount of time to wait for the next request when keep-alives are enabled
    idle: 10m

# Provider configurations
providers:
  # Anthropic Claude configuration
  anthropic:
    # Base URL for Anthropic API (can be changed for custom endpoints)
    base_url: "https://api.anthropic.com"
    
    # Maximum number of retries for failed requests
    max_retries: 3
  
  # OpenAI configuration
  openai:
    # API key for OpenAI
    # Can also be set via OPENAI_API_KEY environment variable
    # api_key: "..."
    
    # Base URL for OpenAI API (can be changed for custom endpoints)
    # Can also be set via OPENAI_BASE_URL environment variable
    # This is an API prefix; the proxy appends /chat/completions or /responses.
    # base_url: "https://api.openai.com/v1"

# Storage configuration
storage:
  # Omit these fields to use the operating system standard data and backup
  # directories. Relative YAML paths resolve from this config file's directory.
  # db_path: "/custom/path/requests.db"
  # backup_dir: "/custom/path/backups"

  # Maximum request/response bytes retained in the database.
  # The proxied exchange is not truncated. Set to 0 for unlimited capture.
  max_capture_bytes: 10485760
  
  # Directory for storing request files (if needed in future)
  # requests_dir: "./requests"

# Web interface configuration
web:
  # Store raw SSE data but hide its viewer unless explicitly enabled.
  show_raw_stream_events: false

  # Maximum characters rendered for raw request/response values in the web UI.
  # Set to 0 for unlimited display. These settings do not change SQLite capture.
  raw_request_max_display_chars: 0
  raw_response_max_display_chars: 0

# Subagent Configuration (Optional)
# Enable this feature if you want to route specific Claude Code agents to different LLM providers
# For subagent setup instructions, see: https://docs.anthropic.com/en/docs/claude-code/sub-agents
subagents:
  # Enable subagent routing (default: false)
  enable: false
  
  # Maps Claude Code subagent names to specific models.
  # Only used when enable: true
  # This is not a global incoming-model-to-upstream-model alias map.
  # Request bodies must use the standard "model" field; "model_name" is not recognized.
  mappings:
    # Code review specialist (example)
    # code-reviewer: "gpt-4o"
    
    # Data analysis expert (example)
    # data-analyst: "o3"
    
    # Documentation writer (example)
    # doc-writer: "gpt-3.5-turbo"

# Environment variable overrides:
# The following environment variables will override the YAML configuration:
#
# Server:
#   ACP_CONFIG                - Explicit configuration file path
#   ACP_DATA_DIR              - Data directory when DB_PATH is unset
#   ACP_HOST                  - Listen host (default: 127.0.0.1)
#   ACP_PORT                  - Server port
#   PORT                      - Backward-compatible server port alias
#   ACP_ACCESS_TOKEN          - Required for non-loopback listening
#   READ_TIMEOUT             - Read timeout duration
#   WRITE_TIMEOUT            - Write timeout duration
#   IDLE_TIMEOUT             - Idle timeout duration
#
# Anthropic:
#   ANTHROPIC_FORWARD_URL    - Anthropic base URL
#   ANTHROPIC_VERSION        - Anthropic API version
#   ANTHROPIC_MAX_RETRIES    - Maximum retries for Anthropic requests
#
# OpenAI:
#   OPENAI_API_KEY           - OpenAI API key
#   OPENAI_BASE_URL          - OpenAI base URL
#
# Storage:
#   DB_PATH                  - Database file path
#
# Subagent mappings currently have no environment-variable override and must be
# configured in the subagents.mappings section above.
