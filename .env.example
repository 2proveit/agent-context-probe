# Agent Context Probe Configuration

# Server Configuration
# ACP_CONFIG=/absolute/path/to/config.yaml
ACP_HOST=127.0.0.1
ACP_PORT=3001
# Required when ACP_HOST is not a loopback address.
# ACP_ACCESS_TOKEN=replace-with-at-least-16-characters
READ_TIMEOUT=500s
WRITE_TIMEOUT=500s
IDLE_TIMEOUT=500s

# Anthropic API Configuration
# URL to forward requests to (the actual Anthropic API)
ANTHROPIC_FORWARD_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_MAX_RETRIES=3

# Storage Configuration
# Omit both variables to use the operating system standard data directory.
# ACP_DATA_DIR=/absolute/path/to/data
# DB_PATH=/absolute/path/to/requests.db
